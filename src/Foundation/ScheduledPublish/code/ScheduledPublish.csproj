<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
	<ApplicationIcon />
	<OutputType>Library</OutputType>
	<StartupObject />
	<Authors>Nehemiah Jeyakumar</Authors>
	<!-- Version, company, copyright, product and description attributes are generated from these
	     properties (Version comes from scripts/Build-Package.ps1); Properties/AssemblyInfo.cs keeps the rest. -->
	<Company>Nehemiah Jeyakumar</Company>
	<Product>Sitecore Scheduled Publish</Product>
	<Copyright>Copyright © 2012-2015 Hedgehog Development, LLC. Modifications copyright © Nehemiah Jeyakumar. Licensed under Apache-2.0.</Copyright>
	<AssemblyTitle>ScheduledPublish</AssemblyTitle>
	<GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
  </PropertyGroup>
  <!-- NuGet package (dotnet pack). Run scripts/Build-Package.ps1 so the IAR .dat files exist before packing. -->
  <PropertyGroup>
	<PackageId>SCScheduledPublish</PackageId>
	<Version>10.5.0</Version>
	<Title>Sitecore Scheduled Publish</Title>
	<Description>Schedule publish and unpublish of Sitecore items. Items ship as Items as Resources (IAR) files, so no Installation Wizard or Package Designer is required.</Description>
	<PackageTags>Sitecore;SitecoreModule;Sitecore10;SitecoreXM;SitecoreXP;Publishing;ScheduledPublish;ScheduledPublishing;Unpublish;IAR;ItemsAsResources</PackageTags>
	<PackageProjectUrl>https://github.com/nehemiahj/sitecore-scheduled-publish</PackageProjectUrl>
	<RepositoryUrl>https://github.com/nehemiahj/sitecore-scheduled-publish</RepositoryUrl>
	<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<IarOutputPath Condition="'$(IarOutputPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\artifacts\iar\</IarOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sitecore.Kernel" Version="10.5.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sysglobl" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Design" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Linq" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.InteropServices" />
    <Reference Include="System.Runtime.InteropServices.RuntimeInformation" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Web" />
    <Reference Include="System.Threading.Thread" />
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.DynamicData" />
    <Reference Include="System.Web.Entity" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup> 
  <ItemGroup>
    <Content Include="App_Config\Include\ZZ_ScheduledPublish\ZZ_ScheduledPublishControl.config" />
    <Content Include="sitecore\shell\Applications\Content Manager\Dialogs\Edit Scheduled Publish\Edit Scheduled Publish.xml" />
    <Content Include="sitecore\shell\Applications\Content Manager\Dialogs\Schedule Publish\Schedule Publish.xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ScheduledPublish.module.json" Pack="false" />
  </ItemGroup>
  <!-- Webroot files go under content\ (packages.config copies them into the project). PackageReference
       consumers get them through build\SCScheduledPublish.targets as linked Content items. -->
  <ItemGroup>
    <Content Update="App_Config\**;sitecore\**" Pack="true" PackagePath="content\%(RelativeDir)" />
    <None Include="$(IarOutputPath)items.master.schedule.publish.dat" Pack="true" PackagePath="content\App_Data\items\master\" />
    <None Include="$(IarOutputPath)items.core.schedule.publish.dat" Pack="true" PackagePath="content\App_Data\items\core\" />
    <None Update="nuget\SCScheduledPublish.targets" Pack="true" PackagePath="build\SCScheduledPublish.targets" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="EnsureIarFiles" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(IarOutputPath)items.master.schedule.publish.dat') Or !Exists('$(IarOutputPath)items.core.schedule.publish.dat')"
           Text="IAR files not found in $(IarOutputPath). Run scripts/Build-Package.ps1 (or dotnet sitecore itemres create) first." />
  </Target>
</Project>